# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== Seguridad de la API =====
# Genera SECRET_KEY con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_this_to_a_long_random_value
FLASK_DEBUG=false
API_AUTH_REQUIRED=true

# La API valida los Bearer tokens del frontend contra PocketBase.
POCKETBASE_URL=https://pocketbase.koolgrowth.com
VITE_POCKETBASE_URL=https://pocketbase.koolgrowth.com

# Orígenes permitidos para llamadas cross-origin a /api/*.
# Si frontend y backend están en el mismo dominio, puedes dejar solo localhost
# para desarrollo.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Contraseña fuerte para Neo4j. No uses el valor antiguo por defecto.
NEO4J_PASSWORD=change_this_neo4j_password

# ===== Graphiti graph-extraction LLM (optional) =====
# The simulation LLM (LLM_MODEL_NAME) can be a reasoning model (MiniMax-M2.7,
# DeepSeek-R1), but graph extraction needs reliable structured output
# (response_format=json_schema). Reasoning models silently ignore
# json_schema and drift to invented field names → ~50 % invalid extractions.
#
# These three vars configure a SEPARATE provider for Graphiti. Each one
# falls back to its LLM_* counterpart when unset, so you only set the ones
# that differ from the main LLM.
#
# Recommended (tested in production):
#   · BytePlus Seed-2-0-lite    (cheap, supports json_schema)
#   · DeepSeek-V3 (deepseek-chat) — supports json_schema, cheap
#   · Qwen-Plus / Qwen-Max (Aliyun Bailian)
#
# GRAPHITI_LLM_API_KEY=your_byteplus_or_deepseek_key
# GRAPHITI_LLM_BASE_URL=https://ap-southeast.bytepluses.com/api/v3
# GRAPHITI_LLM_MODEL_NAME=seed-2-0-lite-260228

# ===== Vision LLM — image upload support (optional) =====
# When a PNG/JPG/WEBP image is uploaded as the seed document, Simuloo calls
# a vision model to generate a detailed text description before feeding it to
# the simulation pipeline.
#
# Uses the standard OpenAI image_url format (compatible with most providers).
# If the model is unavailable, image uploads still work — a placeholder text
# is returned instead of a full visual analysis.
#
# IMPORTANT for MiniMax users:
#   MiniMax-VL-01 only works on the CHINESE endpoint (api.minimaxi.chat/v1).
#   The international endpoint (api.minimax.io/v1) returns "unknown model".
#   You must set VISION_LLM_BASE_URL explicitly if your main LLM uses the
#   international endpoint.
#
# VISION_LLM_API_KEY=your_vision_api_key_here    # defaults to LLM_API_KEY
# VISION_LLM_BASE_URL=https://api.minimaxi.chat/v1  # for MiniMax-VL-01
# VISION_LLM_MODEL_NAME=MiniMax-VL-01

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# ===== Jev (TypeSafe) — filtro de entidades antes de crear agentes (opcional) =====
# Descarta las entidades que no opinarían en redes (tiendas de apps, nube,
# analítica...) y avisa si la audiencia real es baja. Sin clave, no filtra nada.
# TYPESAFE_API_KEY=your_typesafe_key
# JEV_ENTITY_FILTER=true
# JEV_DROP_CONFIDENCE=0.8
# JEV_MIN_AUDIENCE_RATIO=0.4

# ===== Investigación en internet antes de la ontología (opcional, la elige el usuario) =====
# Búsqueda web en el servidor del proveedor (API compatible con Anthropic:
# POST {base}/anthropic/v1/messages). La base sale de LLM_BASE_URL quitando un
# /v1 final (MiniMax: https://api.minimax.io). Clave y modelo, los del LLM.
# WEB_RESEARCH_ENABLED=true
# WEB_RESEARCH_MODEL=MiniMax-M3
# WEB_RESEARCH_BASE_URL=https://api.minimax.io
# WEB_RESEARCH_API_KEY=your_key_here
# WEB_RESEARCH_MAX_TOKENS=4000
# Tiempo total de la investigación (búsqueda + redacción), en segundos
# WEB_RESEARCH_TIMEOUT=240
# Obliga a buscar (tool_choice=any); sin él el modelo puede contestar de memoria
# WEB_RESEARCH_FORCE_SEARCH=true

# ===== Embeddings del grafo (Graphiti) =====
# Sin EMBEDDING_API_KEY / EMBEDDING_BASE_URL se usan los del LLM principal. Ojo: si el proveedor del LLM no ofrece
# un endpoint /embeddings, la construcción del grafo falla a mitad; en ese caso define estas tres con otro proveedor.
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=your_embedding_key
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# ===== Ajustes de funcionamiento (todos opcionales; entre paréntesis, el valor por defecto) =====
# Una variable VACÍA o con un valor inválido ("30s") no impide arrancar: se avisa por stderr y se usa el valor
# por defecto. En Coolify basta con definirlas en su panel (llegan al contenedor aunque no estén en docker-compose.yml).
#
# Quién ve los proyectos antiguos (anteriores al aislamiento por usuario): el id de un usuario de PocketBase.
# Vacío = solo el administrador.
# LEGACY_OWNER_ID=
# Proxies inversos delante de la app (Coolify/Traefik = 1; 0 si se expone directo)
# TRUSTED_PROXIES=1
# Límites de tasa por usuario/IP
# API_READ_RATE_LIMIT=600 per minute
# API_WRITE_RATE_LIMIT=30 per minute
#
# Modelo: plazo por llamada (s) y reintentos del SDK (240 / 2); el grafo tiene los suyos (180 / 900)
# LLM_TIMEOUT_SECONDS=240
# LLM_MAX_RETRIES=2
# GRAPH_LLM_TIMEOUT_SECONDS=180
# GRAPH_EPISODE_TIMEOUT_SECONDS=900
#
# Simulaciones: procesos vivos a la vez (2; cada una ~1 GB), tope de rondas (100) y segundos que el entorno
# espera entrevistas antes de cerrarse solo (1200; 0 = nunca)
# MAX_CONCURRENT_SIMULATIONS=2
# SIMULATION_MAX_ROUNDS=100
# SIM_IDLE_TIMEOUT_SECONDS=1200
# Pipelines automáticos vivos a la vez, en total y por usuario (3 / 2)
# MAX_ACTIVE_PIPELINES=3
# MAX_ACTIVE_PIPELINES_PER_USER=2
#
# Topes de una sola petición: cuerpo JSON en bytes (1048576), ficheros (10), imágenes (3), caracteres de texto
# en total (1000000)
# MAX_BODY_BYTES=1048576
# MAX_UPLOAD_FILES=10
# MAX_UPLOAD_IMAGES=3
# MAX_TOTAL_TEXT_CHARS=1000000
#
# /health/ready avisa si queda menos de este espacio libre (MB) en el disco de datos (200)
# MIN_FREE_DISK_MB=200
#
# Copia de seguridad automática: credencial de SOLO LECTURA para GET /api/backup/export (cabecera X-Backup-Token), que
# recoge el Mac mini cada noche (ops/backup_remoto.sh). Mínimo 32 caracteres; sin ella la ruta no existe (404). No es la
# clave de administrador y no vale para otras rutas. Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
# y poner el MISMO valor en ~/.koolbrand/secrets/simuloo-backup-token del Mac mini («X-Backup-Token: <valor>», chmod 600).
# BACKUP_TOKEN=
